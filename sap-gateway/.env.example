# SAP HANA connection
HANA_SERVER=127.0.0.1
HANA_PORT=30015
HANA_USER=AI_AGENT_READONLY
HANA_PASSWORD=CHANGE_ME
HANA_SCHEMA=YOUR_B1_DATABASE

# Local API - keep localhost-only unless you deliberately add network auth
HOST=127.0.0.1
PORT=3000

# Local API authentication. Generate a long random value.
# The AI client must send: Authorization: Bearer <API_TOKEN>
API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_TOKEN

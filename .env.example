# ============================================================
# MGMG Digital Command Center — environment configuration
# Copy to .env and fill every [PLACEHOLDER]. Never commit .env.
# In production these live in Render's "mgmg-shared" environment group.
# ============================================================

# --- General ---
TZ=Asia/Tashkent
ENVIRONMENT=production          # production | staging | dev
LOG_LEVEL=INFO
DRY_RUN=false                   # true = agents compute but send nothing

# --- PostgreSQL (central data store) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mgmg
POSTGRES_USER=[POSTGRES_USER]
POSTGRES_PASSWORD=[POSTGRES_PASSWORD]

# --- SAP Business One (read-only, pushed from the gateway's own machine) ---
# The gateway pushes to /webhooks/sap-push/{secret} and
# /webhooks/sap-gateway-push/{tool}/{secret} — see scripts/sap-gateway-push/.
SAP_PUSH_WEBHOOK_SECRET=[RANDOM_SECRET]
SAP_DEFAULT_CURRENCY=USD

# --- Lead Agent: search sources (paused unless LEAD_AGENT_ENABLED=true) ---
LEAD_AGENT_ENABLED=false
SERPAPI_API_KEY=[SERPAPI_API_KEY]
TAVILY_API_KEY=[TAVILY_API_KEY]
# Full service-account JSON key content (not a file path) -- see
# https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_SERVICE_ACCOUNT_JSON=[GOOGLE_SERVICE_ACCOUNT_JSON]
GOOGLE_LEADS_SHEET_ID=[GOOGLE_LEADS_SHEET_ID]     # from the sheet's URL

# --- AI (OpenRouter) ---
OPENROUTER_API_KEY=[OPENROUTER_API_KEY]
# Tried in order when the primary model fails (comma-separated). End the
# chain on cheap PAID capacity: ':free' models 429 unreliably.
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_FALLBACK_MODELS=google/gemini-3.7-flash

# --- Admin Bot / OPS Manager Bot ---
# Admin Bot: admin-only, handles employee access Accept/Reject. Employees
# never message this bot directly -- see docs/agent-specs/05-org-bot.md.
ADMIN_BOT_TELEGRAM_BOT_TOKEN=[BOT_TOKEN]
ADMIN_BOT_TELEGRAM_CHAT_ID=[CHAT_ID]       # the admin's own chat
ADMIN_BOT_WEBHOOK_SECRET=[RANDOM_SECRET]
ADMIN_BOT_ADMIN_USER_ID=                   # optional hardening: only this Telegram user id's taps are honored; blank = disabled

# OPS Manager Bot: the bot employees and the Director talk to. It also
# delivers every scheduled agent's message to whoever holds the Director role.
OPS_MANAGER_BOT_TELEGRAM_BOT_TOKEN=[BOT_TOKEN]
OPS_MANAGER_BOT_WEBHOOK_SECRET=[RANDOM_SECRET]
OPS_MANAGER_BOT_MODEL=google/gemini-3.8-flash
OPS_MANAGER_BOT_FALLBACK_MODELS=google/gemini-3.7-flash

# --- Daily reports (16:00 ask, 17:00 reminder) ---
DAILY_REPORTS_ENABLED=false

# --- Task tracker (deadlines, reminders, Friday scorecard) ---
TASK_TRACKER_ENABLED=true

# --- Written permissions (EMJ-SOP-ADM-01) ---
PERMISSIONS_ENABLED=true
# Telegram ids who may decide besides the Director, comma-separated. The SOP
# allows a deputy only with written authority, so this list is explicit.
PERMISSION_DEPUTY_TELEGRAM_IDS=
# Payment gate: "limit_in_som:telegram_id,..." — empty = the Director decides all.
PERMISSION_APPROVAL_TIERS=

# --- Database viewer (read-only web page at /db on the API) ---
# Empty = the page is switched off. Use a long random password.
DB_VIEWER_PASSWORD=

# --- Agent write gate ---
# false = agents compute and log intended writes but never send them.
AGENT_WRITES_ENABLED=false

# --- Bot kill switch ---
# true = both bots stop responding and the scheduled agents send nothing.
# Nothing is deleted — set back to false to resume.
BOTS_FROZEN=false

# --- Business rules ---
DEFAULT_CURRENCY=UZS
USD_UZS_REFERENCE_RATE=12800

# ============================================================
# MGMG Digital Command Center — environment configuration
# Copy to .env and fill every [PLACEHOLDER]. Never commit .env.
# ============================================================

# --- General ---
TZ=Asia/Tashkent
ENVIRONMENT=production          # production | staging | dev
LOG_LEVEL=INFO
DRY_RUN=false                   # true = agents compute but send nothing

# --- PostgreSQL (central data store) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mgmg
POSTGRES_USER=[POSTGRES_USER]
POSTGRES_PASSWORD=[POSTGRES_PASSWORD]
N8N_DB_NAME=n8n

# --- n8n ---
N8N_HOST=[VPS_HOSTNAME_OR_IP]
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://[VPS_HOSTNAME]/
N8N_ENCRYPTION_KEY=[RANDOM_32_CHARS]      # openssl rand -hex 16
N8N_BASIC_AUTH_USER=[N8N_ADMIN_USER]
N8N_BASIC_AUTH_PASSWORD=[N8N_ADMIN_PASSWORD]

# --- SAP Business One Service Layer (READ-ONLY user) ---
SAP_BASE_URL=https://[SAP_HOST]:50000/b1s/v1
SAP_COMPANY_DB=[SAP_COMPANY_DB]
SAP_USERNAME=[SAP_READONLY_USER]
SAP_PASSWORD=[SAP_READONLY_PASSWORD]
SAP_VERIFY_SSL=false            # SAP B1 SL commonly ships a self-signed cert
SAP_TIMEOUT_SECONDS=60

# --- MGMG's own sales CRM (replaces amoCRM) ---
CRM_BASE_URL=https://sales-crm-roan-six.vercel.app
CRM_API_KEY=[CRM_API_KEY]

# --- amoCRM / Kommo (superseded by the in-house CRM above) ---
AMOCRM_SUBDOMAIN=[SUBDOMAIN]              # without .amocrm.ru
AMOCRM_DOMAIN=amocrm.ru                   # or kommo.com
AMOCRM_LONG_LIVED_TOKEN=[TOKEN]
AMOCRM_WEBHOOK_SECRET=[RANDOM_SECRET]     # shared secret in the webhook URL path
AMOCRM_MAX_RPS=7                          # hard platform limit

# --- Microsoft Graph (app-only / client credentials) ---
MS_TENANT_ID=[TENANT_ID]
MS_CLIENT_ID=[CLIENT_ID]
MS_CLIENT_SECRET=[CLIENT_SECRET]
MS_GRAPH_SCOPE=https://graph.microsoft.com/.default
MS_TEAM_OWNER_UPN=[ceo@yourdomain.com]    # owner for the Command Center team
MS_PLANNER_GROUP_ID=                      # filled in after the team is created
MS_PLANNER_DEFAULT_PLAN_ID=               # plan the follow-up agent writes into
# Teams Incoming Webhook for the sales channel. Used instead of Graph
# chatMessage because posting channel messages with application permissions is
# a protected API that most tenants do not grant.
TEAMS_SALES_WEBHOOK_URL=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=[BOT_TOKEN]
TELEGRAM_CEO_CHAT_ID=[CHAT_ID]
TELEGRAM_ALERTS_CHAT_ID=[CHAT_ID]         # may equal CEO chat for now

# --- Verifix (HR) ---
VERIFIX_MODE=csv                          # api | csv
VERIFIX_BASE_URL=[VERIFIX_API_URL]
VERIFIX_API_TOKEN=[VERIFIX_TOKEN]
VERIFIX_CSV_DIR=/app/data/verifix          # where the daily CSV export lands

# --- Agent write gate (security rule #1: read-only for the first 90 days) ---
# false = agents compute and log writes but never send them to amoCRM/Planner.
# SAP is read-only regardless of this flag — the SAP client has no write path.
AGENT_WRITES_ENABLED=false

# --- Business rules ---
DEFAULT_CURRENCY=UZS
USD_UZS_REFERENCE_RATE=12800
AR_BUCKET_CRITICAL_DAYS=90
AR_BUCKET_WARNING_DAYS=30
DAILY_BRIEF_HOUR_LOCAL=08                 # Asia/Tashkent

# ============================================================
# MGMG Digital Command Center — environment configuration
# Copy to .env and fill every [PLACEHOLDER]. Never commit .env.
# ============================================================

# --- General ---
TZ=Asia/Tashkent
ENVIRONMENT=production          # production | staging | dev
LOG_LEVEL=INFO
DRY_RUN=false                   # true = agents compute but send nothing

# --- PostgreSQL (central data store) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mgmg
POSTGRES_USER=[POSTGRES_USER]
POSTGRES_PASSWORD=[POSTGRES_PASSWORD]
N8N_DB_NAME=n8n

# --- n8n ---
N8N_HOST=[VPS_HOSTNAME_OR_IP]
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://[VPS_HOSTNAME]/
N8N_ENCRYPTION_KEY=[RANDOM_32_CHARS]      # openssl rand -hex 16
N8N_BASIC_AUTH_USER=[N8N_ADMIN_USER]
N8N_BASIC_AUTH_PASSWORD=[N8N_ADMIN_PASSWORD]

# --- SAP Business One Service Layer (READ-ONLY user) ---
SAP_BASE_URL=https://[SAP_HOST]:50000/b1s/v1
SAP_COMPANY_DB=[SAP_COMPANY_DB]
SAP_USERNAME=[SAP_READONLY_USER]
SAP_PASSWORD=[SAP_READONLY_PASSWORD]
SAP_VERIFY_SSL=false            # SAP B1 SL commonly ships a self-signed cert
SAP_TIMEOUT_SECONDS=60

# --- MGMG's own sales CRM ---
CRM_BASE_URL=https://sales-crm-roan-six.vercel.app
CRM_API_KEY=[CRM_API_KEY]

# --- Lead Agent: search & tender sources ---
# true = runs each morning; false (default) = paused, the morning job skips it.
LEAD_AGENT_ENABLED=false
# true = 16:00 daily-report ask + 17:00 reminder run; false (default) = paused.
DAILY_REPORTS_ENABLED=false
SERPAPI_API_KEY=[SERPAPI_API_KEY]
TAVILY_API_KEY=[TAVILY_API_KEY]
WORLDBANK_SEARCH_URL=https://search.worldbank.org/api/v3/projects   # public, no key needed
# Confirmed-working endpoints below are unknown -- pull the exact URLs from
# the existing n8n workflow's HTTP Request nodes before filling these in.
ETENDER_UZEX_URL=
XT_XARID_URL=
EGOV_OPENDATA_URL=

# --- Lead Agent: AI qualification ---
# "openrouter" or "deepseek" -- both are OpenAI-compatible, switching is a
# one-line change here, no code touched.
AI_PROVIDER=openrouter

OPENROUTER_API_KEY=[OPENROUTER_API_KEY]
# Tried in order when the primary model fails (comma-separated).
# Free ':free' models share a congested pool and 429'd on 3 of 4 test
# runs -- end this chain on cheap PAID capacity so the morning run
# cannot silently produce nothing.
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_FALLBACK_MODELS=google/gemini-3.7-flash

DEEPSEEK_API_KEY=[DEEPSEEK_API_KEY]
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_FALLBACK_MODELS=deepseek-v4-flash,deepseek-v4-pro

# --- Lead Agent: storage + delivery ---
# Full service-account JSON key content (not a file path) -- see
# https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_SERVICE_ACCOUNT_JSON=[GOOGLE_SERVICE_ACCOUNT_JSON]
GOOGLE_LEADS_SHEET_ID=[GOOGLE_LEADS_SHEET_ID]     # from the sheet's URL
# Telegram delivery goes through OPS Manager Bot -- see below.

# --- Admin Bot / OPS Manager Bot ---
# Admin Bot: admin-only, handles employee access Accept/Reject. Employees
# never message this bot directly -- see docs/agent-specs/05-org-bot.md for
# why (Telegram can't be cold-messaged by a bot the user hasn't started).
ADMIN_BOT_TELEGRAM_BOT_TOKEN=[BOT_TOKEN]
ADMIN_BOT_TELEGRAM_CHAT_ID=[CHAT_ID]       # the admin's own chat
ADMIN_BOT_WEBHOOK_SECRET=[RANDOM_SECRET]
ADMIN_BOT_ADMIN_USER_ID=                   # optional hardening: only this Telegram user id's Accept/Reject taps are honored; blank = disabled

# OPS Manager Bot: the AI task-routing brain employees and the Director talk to.
# It also delivers every scheduled agent's Telegram message (CEO Daily Brief,
# Receivables, Lead Agent) to whoever holds the Director role.
# Runs on its own provider (OPS_MANAGER_BOT_PROVIDER), independent of
# AI_PROVIDER above which Lead Agent uses. OpenRouter + Gemini 3.8 Flash since
# 2026-09-14 (was DeepSeek), reusing OPENROUTER_API_KEY above; the fallback is
# Gemini 3.7 Flash on the same provider.
OPS_MANAGER_BOT_TELEGRAM_BOT_TOKEN=[BOT_TOKEN]
OPS_MANAGER_BOT_WEBHOOK_SECRET=[RANDOM_SECRET]
OPS_MANAGER_BOT_PROVIDER=openrouter
OPS_MANAGER_BOT_MODEL=google/gemini-3.8-flash
OPS_MANAGER_BOT_FALLBACK_MODELS=google/gemini-3.7-flash

# --- Written permissions (EMJ-SOP-ADM-01) ---
# true (default) = employees can raise written permission requests in the bot.
PERMISSIONS_ENABLED=true
# Telegram ids who may decide besides the Director, comma-separated. The SOP
# allows a deputy only with written authority, so this list is explicit.
PERMISSION_DEPUTY_TELEGRAM_IDS=

# --- Agent write gate (security rule #1: read-only for the first 90 days) ---
# false = agents compute and log intended writes but never send them.
# SAP is read-only regardless of this flag — the SAP client has no write path.
AGENT_WRITES_ENABLED=false

# --- Bot kill switch ---
# true = Admin Bot + OPS Manager Bot stop responding to Telegram entirely,
# AND the scheduled agents (CEO Daily Brief, Receivables, Lead Agent) stop
# sending their Telegram messages too, since they route through OPS Manager
# Bot's token. Nothing is deleted or reconfigured — set back to false and
# restart to resume exactly where it left off.
BOTS_FROZEN=false

# --- Business rules ---
DEFAULT_CURRENCY=UZS
USD_UZS_REFERENCE_RATE=12800
AR_BUCKET_CRITICAL_DAYS=90
AR_BUCKET_WARNING_DAYS=30
DAILY_BRIEF_HOUR_LOCAL=08                 # Asia/Tashkent
